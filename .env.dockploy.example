# Minipanelabyzum — despliegue en Dockploy
# Copia a .env.dockploy y ajusta los valores antes de desplegar.

JWT_SECRET=                          # openssl rand -base64 32
JWT_EXPIRES_IN=2d
ALLOW_INSECURE_AUTH_COOKIES=false

# URL pública del panel (la que abre el navegador)
FRONTEND_URL=https://panel.tudominio.com

# Idioma por defecto
NEXT_PUBLIC_DEFAULT_LANGUAGE=es

# Directorio en el host donde viven servidores MC + data del panel
BASE_DIR=/var/lib/minipanelabyzum

# Puertos internos expuestos (Dockploy puede mapear dominios encima)
BACKEND_PORT=8091
FRONTEND_PORT=3000

# Proxy interno Next.js → backend (nombre del servicio Docker)
BACKEND_PROXY_URL=http://backend:8091

# El frontend usa /api/backend por defecto; no hace falta NEXT_PUBLIC_BACKEND_URL
# si frontend y backend comparten el mismo dominio vía Dockploy.
