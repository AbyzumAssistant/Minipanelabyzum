# Minipanelabyzum — despliegue en Dockploy
# Copia a .env.dockploy y ajusta los valores antes de desplegar.

JWT_SECRET=                          # openssl rand -base64 32
JWT_EXPIRES_IN=2d
ALLOW_INSECURE_AUTH_COOKIES=false

# URL pública del panel (debe coincidir con el Host en Domains de Dockploy)
FRONTEND_URL=https://mccubneuifbu23d.abyzum.com

# Idioma por defecto
NEXT_PUBLIC_DEFAULT_LANGUAGE=es

# Directorio en el host donde viven servidores MC + data del panel
BASE_DIR=/var/lib/minipanelabyzum
COMPOSE_PROJECT=mcabyzum

# Puertos en el host (Container Port en Domains sigue siendo 3000 para frontend)
BACKEND_PORT=8091
FRONTEND_PORT=3001

# Proxy interno Next.js → backend (nombre del servicio Docker)
BACKEND_PROXY_URL=http://backend:8091
NEXT_PUBLIC_BACKEND_URL=/api/backend

# Dockploy → Domains: servicio frontend, host mccubneuifbu23d.abyzum.com,
# container port 3000, HTTPS on. Tras cambiar env o dominio, redeploy.
